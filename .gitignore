# ─────────────────────────────────────────────────────────────
# Secrets — keep these OUT of a public repo
# ─────────────────────────────────────────────────────────────
# Local SDK path (also leaks your username/machine layout)
local.properties

# Signing keystores and credentials
*.jks
*.keystore
keystore.properties
key.properties
signing.properties

# Service-account / API keys / certs
google-services.json
secrets.properties
*.p12
*.pem
.env
.env.*

# ─────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────
build/
captures/
out/
release/
bin/
gen/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/

# Packaged artifacts
*.aab
*.ap_
*.aar
*.dex
*.class

# ─────────────────────────────────────────────────────────────
# IDE — Android Studio / IntelliJ
# ─────────────────────────────────────────────────────────────
*.iml
.idea/
.fleet/
.vscode/

# ─────────────────────────────────────────────────────────────
# Logs, profiling and crash dumps
# ─────────────────────────────────────────────────────────────
*.log
*.hprof
lint-results*.html
lint-results*.xml

# ─────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

