    <string name="variant_leningradka_desc">Mountain and whist points doubled; bullets doubled at settlement.</string>
    <string name="variant_rostov">Rostov</string>
    <string name="variant_rostov_desc">No mountain — each mountain unit becomes 5 whist for each opponent. Other whist halved.</string>

